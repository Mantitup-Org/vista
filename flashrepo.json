{
  "runner": {
    "packageManager": "pnpm@8.15.0"
  },
  "tasks": {
    "build": {
      "recursive": true,
      "ifPresent": true
    },
    "dev": {
      "recursive": true,
      "ifPresent": true,
      "parallel": true,
      "persistent": true
    },
    "test": {
      "recursive": true,
      "ifPresent": true
    },
    "clean": {
      "recursive": true,
      "ifPresent": true
    }
  },
  "outputs": [
    ".vista/**",
    ".flash/**",
    "dist/**",
    "*.node"
  ]
}
